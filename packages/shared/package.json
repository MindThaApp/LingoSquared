{
  "name": "@lingo/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Platform-agnostic API client/types, i18n core, and pure-TS helper libs shared between Lingo^2's web frontend and (future) mobile app. No build step: consumers resolve these subpaths straight to TypeScript source via the exports map below, the same way frontend/'s own Vite+tsc toolchain already handles any .ts file.",
  "exports": {
    "./api/client": "./src/api/client.ts",
    "./api/endpoints": "./src/api/endpoints.ts",
    "./api/types": "./src/api/types.ts",
    "./lib/scripts": "./src/lib/scripts.ts",
    "./lib/formatAnswer": "./src/lib/formatAnswer.ts",
    "./lib/gradingResult": "./src/lib/gradingResult.ts",
    "./lib/cefr": "./src/lib/cefr.ts",
    "./lib/flags": "./src/lib/flags.ts",
    "./lib/answerInputMode": "./src/lib/answerInputMode.ts",
    "./lib/sampleSpeechText": "./src/lib/sampleSpeechText.ts",
    "./lib/unitIcons": "./src/lib/unitIcons.ts",
    "./lib/localizedLanguageName": "./src/lib/localizedLanguageName.ts",
    "./audio/audioKey": "./src/audio/audioKey.ts",
    "./i18n": "./src/i18n/index.ts"
  },
  "dependencies": {
    "i18next": "^26.3.4",
    "react-i18next": "^17.0.8",
    "lucide-react": "^1.23.0"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "~6.0.2"
  }
}
