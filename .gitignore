# npm workspaces (root package.json, added for the @lingo/shared
# extraction) hoist most deps into the repo-root node_modules instead of
# frontend/node_modules -- frontend/.gitignore's own "node_modules" entry
# only covers that directory, not this one.
/node_modules/
packages/*/node_modules/
