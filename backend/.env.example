API_PORT=8020
POSTGRES_DB=lingosquared
POSTGRES_USER=lingosquared
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://lingosquared:change-me@db:5432/lingosquared
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_SECONDS=1800
# Seconds during which a just-rotated refresh token may be retried and get the
# same successor back (lost response on reload, two tabs). 0 disables.
REFRESH_REUSE_GRACE_SECONDS=30
# How many retries of one rotation that window may answer before a retry
# counts as reuse.
REFRESH_REUSE_GRACE_MAX_REPLAYS=3
ADMIN_EMAILS=admin@example.com
ENABLE_HEARTS=false
ENABLE_GEMS=false
ENABLE_LEADERBOARD=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:5180
# Google Cloud TTS (superseded ElevenLabs 2026-07-04) — raw service-account
# JSON content, not a file path. Covers en/nl/fr/de/it/es/ru/zh. Leave unset
# to run without cloud TTS; /tts degrades to the browser speechSynthesis
# fallback rather than erroring.
GOOGLE_CLOUD_TTS_CREDENTIALS_JSON=
# 1M = the WaveNet/Neural2/Chirp 3 HD free tier (Standard's 4M does not apply).
TTS_MONTHLY_CHAR_BUDGET=1000000
# Azure Cognitive Services Speech — covers Farsi (fa), Google's one real
# voice gap. Get a key from the Azure Portal (Cognitive Services / Speech
# resource) and its region (e.g. "eastus"). Leave unset to run without it;
# /tts degrades the same way as a missing Google credential.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Gemini TTS, used ONLY by scripts/render_audio.py to pre-render Dari (prs); the
# running API never calls it. Placeholder only: save the real key to
# secrets/gemini/api-key.txt (git-excluded) or put it here on the render host.
# Leave empty and prs is skipped with a clear message.
GEMINI_API_KEY=
# Where pre-rendered clips live inside the containers (host dir is mounted there
# by docker-compose.yml; see MEDIA_AUDIO_HOST_DIR and docs/PRE_DEPLOY_RUNBOOK.md).
MEDIA_AUDIO_DIR=/srv/media/audio
# Social sign-in (Google / Apple). Off by default: /auth/social and
# /auth/social/link answer 503 until SOCIAL_SIGN_IN_ENABLED=true AND the
# provider's allowlist below is set. Comma-separate every accepted web, iOS
# and Android client ID (Google) or Services ID / bundle ID (Apple).
# Setup guide: docs/SOCIAL_SIGN_IN.md. Apple needs a real domain with HTTPS.
SOCIAL_SIGN_IN_ENABLED=false
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_AUDIENCE_IDS=
# Sentry crash reporting for server errors. Leave SENTRY_DSN empty to turn it
# off (tests and local runs leave it empty, so nothing is ever sent). The DSN
# comes from the lingosquared-backend project; never commit a real one.
# SENTRY_RELEASE is the git sha or version; SENTRY_ENVIRONMENT defaults to
# "development" for APP_ENV=dev/test and "production.lan" otherwise.
# Details: docs/SENTRY.md.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
