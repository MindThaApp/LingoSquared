# LAN phone-testing build profile.
#
# Vite loads `.env.[mode]` files based on the `--mode` flag (in addition
# to the base `.env`, if present, and `.env.[mode].local`). This file's
# name (`.env.production.lan`) corresponds to mode "production.lan", so
# it is picked up ONLY when building with:
#
#   npm run build -- --mode production.lan
#
# (`vite build`'s default mode is "production", which would load
# `.env.production` instead -- that file does not exist in this repo,
# so a plain `npm run build` still falls back to `frontend/.env`/
# whatever is present, unaffected by this file.)
#
# Points the built SPA at the live backend on the LAN so it can be
# opened from a phone tonight. Baked in at build time -- rebuild and
# re-deploy the static bundle if this ever changes.
VITE_API_BASE_URL=http://192.168.4.4:8010

# VITE_FEEDBACK_API_URL intentionally left unset: it falls back to
# VITE_API_BASE_URL above, which is correct here since there's only
# one backend involved (the LAN server itself), not a "many independent
# local installs" distribution scenario. See frontend/.env.example and
# CLAUDE.md's "Feedback/issue-report collection strategy" section.
