VITE_API_BASE_URL=http://localhost:8000

# Optional. Where the "give feedback"/"report an issue" widget submits
# reports. Falls back to VITE_API_BASE_URL when unset, which is correct
# for a single shared backend (dev, LAN server, or a hosted domain).
# Only set this to something different if this build is distributed as
# many independent local installs (e.g. a "clone and run" shortcut app)
# and you want every install's feedback to reach one central backend
# instead of staying stuck on whichever backend that install runs
# locally -- point it at a stable, internet-reachable URL for the
# backend you actually check.
# VITE_FEEDBACK_API_URL=https://your-central-backend.example.com

# Optional: "Continue with Google" / "Continue with Apple". Each button stays
# hidden while its value is empty, and the backend also needs
# SOCIAL_SIGN_IN_ENABLED=true plus matching audience IDs. Setup guide:
# docs/SOCIAL_SIGN_IN.md. Apple needs a real domain served over HTTPS.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=

# Sentry crash reporting + "Report a problem" (build-time). Leave empty to turn
# Sentry off; reports then go to the app's own feedback endpoint instead. The
# DSN comes from the lingosquared-web project; never commit a real one.
# VITE_SENTRY_RELEASE defaults to the short git sha at build time;
# VITE_SENTRY_ENVIRONMENT defaults to "production.lan" for production builds
# and "development" otherwise. To upload source maps, set SENTRY_AUTH_TOKEN
# in the build shell only (never in a .env file); see docs/SENTRY.md.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_ENVIRONMENT=
