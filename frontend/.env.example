VITE_API_BASE_URL=http://localhost:8000

# Optional. Where the "give feedback"/"report an issue" widget submits
# reports. Falls back to VITE_API_BASE_URL when unset, which is correct
# for a single shared backend (dev, LAN server, or a hosted domain).
# Only set this to something different if this build is distributed as
# many independent local installs (e.g. a "clone and run" shortcut app)
# and you want every install's feedback to reach one central backend
# instead of staying stuck on whichever backend that install runs
# locally -- point it at a stable, internet-reachable URL for the
# backend you actually check. See CLAUDE.md's "Feedback/issue-report
# collection strategy" section.
# VITE_FEEDBACK_API_URL=https://your-central-backend.example.com
